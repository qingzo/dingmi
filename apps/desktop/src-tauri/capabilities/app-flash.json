{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app-flash",
  "description": "flash 窗口能调的叮咪命令（node scripts/caps.mjs --write 按页面代码生成，别手改）",
  "windows": [
    "flash"
  ],
  "permissions": [
    "allow-ai-parse",
    "allow-delete-note",
    "allow-delete-reminder",
    "allow-fit-window",
    "allow-flash-moved",
    "allow-get-settings",
    "allow-launcher-list",
    "allow-launcher-open",
    "allow-launcher-save",
    "allow-launcher-stats",
    "allow-list-devices",
    "allow-list-notes",
    "allow-list-reminders",
    "allow-open-main-nav",
    "allow-open-url",
    "allow-save-note",
    "allow-save-reminder",
    "allow-take-flash-text",
    "allow-trash-action"
  ]
}
